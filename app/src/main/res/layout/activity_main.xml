<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/phase_one_status" />

        <TextView
            android:id="@+id/generated_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/generated_amount_default"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/paid_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/paid_amount_default"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/pending_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pending_amount_default"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:id="@+id/employment_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/register_work_session_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/register_work_session" />

        <Button
            android:id="@+id/register_payment_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_payment" />

        <Button
            android:id="@+id/register_grouped_payment_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_grouped_payment" />

        <Button
            android:id="@+id/reports_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reports_title" />

        <Button
            android:id="@+id/export_backup_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/export_backup" />

        <Button
            android:id="@+id/import_backup_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_backup" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/work_history"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:id="@+id/session_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>